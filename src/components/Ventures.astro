---
// "The ventures I lead" grid, shared by Home and Programs.
import Image from "./Img.astro";
import Icon from "./Icon.astro";
import { brandImg } from "../lib/assets";
import { ventures, clients } from "../data/site";
interface Props { showClients?: boolean; tone?: string; eyebrow?: string; title?: string }
const { showClients = false, tone = "", eyebrow = "Founder & CEO", title = "The Ventures I Lead" } = Astro.props;
---
  <section id="ventures" class:list={["ventures section", tone]}>
    <div class="wrap">
      <div class="center wrap-narrow" data-reveal>
        {eyebrow && <span class="eyebrow">{eyebrow}</span>}
        <h2 class="h2 caps">{title}</h2>
        <hr class="rule" />
      </div>
      <div class="v-grid">
        {ventures.map((v, i) => {
          const Tag = v.href ? "a" : "div";
          return (
            <Tag class="venture" href={v.href || undefined} target={v.href ? "_blank" : undefined} rel={v.href ? "noopener" : undefined} data-reveal style={`--d:${i * 0.08}s`}>
              <div class="v-logo"><Image src={brandImg[v.logo]} alt={v.name} widths={[Math.min(brandImg[v.logo].width, 400)]} sizes="160px" class:list={["badge-img", { wide: brandImg[v.logo].width / brandImg[v.logo].height > 1.5 }]} /></div>
              <h3 class="h3">{v.name}</h3>
              <p class="small muted">{v.text}</p>
              {v.href && <span class="more">Visit <Icon name="arrow-up-right" size={14} /></span>}
            </Tag>
          );
        })}
      </div>
      {showClients && <p class="clients small" data-reveal>
        <span class="eyebrow">Trusted by leaders at</span>
        {clients.join(" · ")}
      </p>}
    </div>
  </section>

<style>
  /* Ventures: one logo box size for every brand, wide wordmarks capped by width. */
  .v-grid { display: grid; gap: 1px; background: var(--line); border: 1px solid var(--line); margin-top: clamp(2rem, 4vw, 3.5rem); }
  .venture { background: #fff; padding: 2.2rem 2rem; display: grid; grid-template-rows: auto auto 1fr auto; align-content: stretch; gap: 0.8rem; transition: background 0.3s; }
  a.venture:hover { background: var(--off); }
  .v-logo { height: 64px; display: flex; align-items: center; }
  .v-logo :global(img) { height: 60px; width: auto; max-width: 140px; object-fit: contain; }
  .v-logo :global(img.wide) { height: auto; width: 168px; max-width: 100%; max-height: 60px; }
  .venture h3 { margin-top: 0.8rem; }
  .venture .more { margin-top: 0.4rem; }
  .clients { margin-top: 3rem; text-align: center; color: var(--ink-soft); line-height: 2; }
  .clients .eyebrow { margin-bottom: 0.6rem; }
  @media (min-width: 640px) { .v-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1000px) { .v-grid { grid-template-columns: repeat(3, 1fr); } }
  .more { display: inline-flex; align-items: center; gap: 0.5em; font-size: var(--fs-micro); font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; }
</style>
