---
// Dark page header used by every inner page: eyebrow, serif title, short lead, optional photo.
import Image from "./Img.astro";
import type { ImageMetadata } from "astro";

interface Props { eyebrow: string; title: string; lead?: string; image?: ImageMetadata; alt?: string; position?: string }
const { eyebrow, title, lead, image, alt = "", position = "center 25%" } = Astro.props;
---
<section class="hero darker grain">
  {image && (
    <div class="bg" aria-hidden="true">
      <Image src={image} alt={alt} widths={[800, 1400, 2000]} sizes="(min-width: 900px) 55vw, 100vw" loading="eager" style={`object-position:${position}`} />
    </div>
  )}
  <div class="wrap inner">
    <div class="copy">
      <span class="eyebrow">{eyebrow}</span>
      <h1 class="h1">{title}</h1>
      {lead && <p class="lead">{lead}</p>}
      <slot />
    </div>
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; padding-block: calc(var(--header-h) + clamp(3.5rem, 2rem + 6vw, 7rem)) clamp(3.5rem, 2rem + 5vw, 6.5rem); }
  .bg { position: absolute; inset: 0 0 0 auto; width: min(55%, 900px); }
  .bg :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .bg::after {
    content: ""; position: absolute; inset: 0;
    background: linear-gradient(90deg, var(--char-950) 0%, rgba(18, 18, 18, 0.55) 35%, rgba(18, 18, 18, 0.1) 100%);
  }
  .inner { position: relative; }
  .copy { max-width: 620px; }
  .copy > * + * { margin-top: 1.4rem; }
  .copy :global(.btn-row) { margin-top: 2rem; }
  @media (max-width: 899px) {
    .bg { width: 100%; opacity: 0.35; }
    .bg::after { background: linear-gradient(180deg, rgba(18, 18, 18, 0.6), var(--char-950)); }
  }
</style>
