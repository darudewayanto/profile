---
// Justified photo row: every photo keeps its own aspect ratio (no cropping) and the row
// shares one height, because each item grows in proportion to its width/height.
// Widths stay at or below the source resolution, so nothing is upscaled.
import Image from "./Img.astro";
import type { ImageMetadata } from "astro";

interface Item { src: ImageMetadata; alt: string; caption?: string }
interface Props { items: Item[] }
const { items } = Astro.props;
---
<div class="gallery wrap">
  {items.map((it, i) => {
    const r = it.src.width / it.src.height;
    return (
      <figure style={`--r:${r.toFixed(4)}`} data-reveal>
        <div class="frame">
          <Image src={it.src} alt={it.alt} widths={[Math.min(it.src.width, 700), it.src.width].filter((w, j, a) => a.indexOf(w) === j)} sizes="(min-width: 900px) 40vw, 100vw" />
        </div>
        {it.caption && <figcaption>{it.caption}</figcaption>}
      </figure>
    );
  })}
</div>

<style>
  .gallery { display: grid; gap: 1.5rem; }
  figure { margin: 0; }
  .frame { aspect-ratio: var(--r); overflow: hidden; background: var(--off); }
  .frame :global(img) { width: 100%; height: 100%; object-fit: cover; }
  figcaption {
    margin-top: 0.8rem;
    font-size: var(--fs-micro); font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted);
  }
  @media (min-width: 760px) {
    .gallery { display: flex; align-items: flex-start; gap: 1.5rem; }
    figure { flex: var(--r) 1 0; min-width: 0; }
  }
</style>
