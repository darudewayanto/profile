---
// Dark "newsletter-style" band from the reference, turned into a WhatsApp opener:
// the visitor types what they're working on and it lands as a pre-filled chat.
import Icon from "./Icon.astro";
import { site } from "../data/site";
interface Props { title?: string }
const { title = "Tell me what you're working on" } = Astro.props;
---
<section class="band darker grain">
  <form class="wrap inner" data-wa-form data-number={site.whatsapp}>
    <h2 class="caps">{title}</h2>
    <label class="field">
      <span class="sr-only">Your message</span>
      <input name="msg" type="text" placeholder="e.g. Coaching for our leadership team" autocomplete="off" />
      <button type="submit" aria-label="Send on WhatsApp"><Icon name="arrow-right" size={18} /></button>
    </label>
  </form>
</section>

<style>
  .band { padding-block: clamp(2.6rem, 2rem + 2vw, 3.6rem); }
  .inner { display: grid; gap: 1.4rem; align-items: center; }
  h2 { font-size: clamp(1.15rem, 0.95rem + 0.9vw, 1.6rem); }
  .field { display: flex; background: #fff; max-width: 440px; width: 100%; }
  input { flex: 1; min-width: 0; border: 0; padding: 0.95rem 1.1rem; font-size: 0.85rem; color: var(--ink); background: transparent; }
  input:focus { outline: none; }
  .field:focus-within { outline: 2px solid var(--greige); outline-offset: 2px; }
  button { width: 54px; border: 0; background: var(--greige-light); color: var(--ink); cursor: pointer; display: grid; place-items: center; transition: background 0.2s; }
  button:hover { background: var(--greige); }
  @media (min-width: 900px) { .inner { grid-template-columns: 1fr auto; } .field { width: 420px; } }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>("[data-wa-form]").forEach((form) => {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const msg = (new FormData(form).get("msg") as string || "").trim();
      const text = `Hello Coach Daru, I'd like to schedule a conversation.${msg ? ` I'm working on: ${msg}` : ""}`;
      window.open(`https://wa.me/${form.dataset.number}?text=${encodeURIComponent(text)}`, "_blank", "noopener");
    });
  });
</script>
