---
import Base from "../layouts/Base.astro";
import Image from "../components/Img.astro";
import Icon from "../components/Icon.astro";
import ConversationBand from "../components/ConversationBand.astro";
import CtaBand from "../components/CtaBand.astro";
import Ventures from "../components/Ventures.astro";
import { u } from "../lib/url";
import { badgeImg, brandImg, crispWidth } from "../lib/assets";
import {
  site, wa, stats, masterBadges, services, speakingTopics, accreditedMembers, masterCredentials,
  instructorBadges, awards, ventures, clients,
} from "../data/site";
import brick from "../assets/photos/daru-brick.jpg";
import jacket from "../assets/photos/daru-jacket.jpg";
import speaking from "../assets/photos/daru-speaking.jpg";
import award100 from "../assets/photos/award-100-best.png";

// Wordmarks (wide logos) and round/square badges get different boxes so they carry the same visual weight.
const isWide = (key: string) => badgeImg[key].width / badgeImg[key].height > 1.5;
---
<Base>
  <!-- HERO -->
  <section class="hero dark grain">
    <div class="hero-photo">
      <Image src={brick} alt="Coach Daru Dewayanto working on a laptop" widths={[700, 1000, 1335]} sizes="(min-width: 900px) 46vw, 100vw" loading="eager" fetchpriority="high" />
    </div>
    <div class="hero-copy">
      <p class="eyebrow sep"><span>Master Coach</span><span>Agile Coach</span><span>Keynote Speaker</span></p>
      <h1 class="display">Agility Begins<br /> Within</h1>
      <p class="hero-why">Agility has to start with us, and real transformation is led by us.</p>
      <p class="lead">
        I'm Daru Dewayanto. For more than 30 years as a corporate leader, entrepreneur and master coach, I've helped
        executives and organizations across Asia, the Middle East and Australia lead change that actually holds.
      </p>
      <div class="btn-row">
        <a class="btn btn-white" href={wa("general")} target="_blank" rel="noopener">Schedule a Consultation</a>
        <a class="btn btn-ghost-light" href={u("/about")}>Meet Coach Daru</a>
      </div>
    </div>
  </section>

  <!-- FIRST & ONLY -->
  <section class="proof section-tight">
    <div class="wrap proof-grid">
      <div data-reveal>
        <span class="eyebrow">The first & only in Asia & Australia</span>
        <h2 class="h3 caps">3 Board Master Agile Coach Credential Holder</h2>
        <p class="muted small">Agile coaching accredited certification holder from three major international organizations.</p>
      </div>
      <ul class="badges" role="list">
        {masterBadges.map((b, i) => (
          <li data-reveal style={`--d:${i * 0.08}s`}>
            <Image src={badgeImg[b.logo]} alt={b.full} width={crispWidth(badgeImg[b.logo], 132)} class="badge-img" />
            <strong>{b.name}</strong>
            <span>{b.by}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="about greige">
    <div class="about-grid">
      <div class="about-card" data-reveal>
        <span class="eyebrow">About</span>
        <h2 class="h1 caps">Daru<br />Dewayanto</h2>
        <p class="tiny-caps">{site.postnominals}</p>
        <div class="stack" style="--stack:1rem">
          <p>
            Founder, CEO and Master Coach of HADE, HADE AI and Center of Agility, with teams in Indonesia, Hong Kong,
            Qatar and Australia. An internationally accredited, award-winning agile coach, named one of the 100 Best Global
            Coaching Leaders by the World Coaching Congress in 2017, 2018 and 2019.
          </p>
          <p>
            I design and lead three internationally accredited certification programs, and I've trained and certified more
            than 1,800 coaches and practitioners. But the work I love most is still the one-on-one conversation with a
            leader who is ready to grow.
          </p>
        </div>
        <p class="signature">Daru Dewayanto</p>
        <a class="link-line" href={u("/about")}>Read my story <Icon name="arrow-right" /></a>
      </div>
      <div class="about-photo media" data-reveal style="--d:.1s">
        <Image src={jacket} alt="Portrait of Coach Daru Dewayanto" widths={[600, 900, 1304]} sizes="(min-width: 900px) 50vw, 100vw" style="object-position: 50% 20%" />
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="stats darker grain section-tight">
    <dl class="wrap stats-grid">
      {stats.map((s, i) => (
        <div data-reveal style={`--d:${i * 0.08}s`}>
          <dt class="sr-only">{s.label}</dt>
          <dd class="num">{s.value}</dd>
          <dd class="lbl">{s.label}</dd>
        </div>
      ))}
    </dl>
  </section>

  <ConversationBand />

  <!-- SERVICES -->
  <section class="services section">
    <div class="wrap-narrow center" data-reveal>
      <span class="eyebrow">How I help</span>
      <h2 class="h2 caps">Coaching That Delivers Results</h2>
      <hr class="rule" />
      <p class="lead">
        Whether you lead a team, a company or a national transformation, the work starts with you and the way you lead.
      </p>
    </div>
    <div class="wrap svc-grid">
      {services.map((s, i) => (
        <a class="svc dark grain" href={u(`/programs#${s.id}`)} data-reveal style={`--d:${i * 0.1}s`}>
          <Icon name={s.icon} size={34} />
          <h3 class="h3 caps">{s.title}</h3>
          <hr class="rule center" />
          <p>{s.short}</p>
          <span class="more">Learn more <Icon name="arrow-right" size={14} /></span>
        </a>
      ))}
    </div>
  </section>

  <!-- SPEAKING -->
  <section class="speak off">
    <div class="speak-grid">
      <div class="speak-photo media">
        <Image src={speaking} alt="Coach Daru delivering a keynote on stage" widths={[700, 1000, 1333]} sizes="(min-width: 900px) 45vw, 100vw" style="object-position: 50% 30%" />
      </div>
      <div class="speak-copy section" data-reveal>
        <span class="eyebrow">Keynote speaker</span>
        <h2 class="h2">Talks that move leaders from insight to action</h2>
        <hr class="rule" />
        <ol class="topics" role="list">
          {speakingTopics.slice(0, 4).map((t, i) => (
            <li><span class="n">0{i + 1}</span><span>{t.title}</span></li>
          ))}
        </ol>
        <div class="btn-row">
          <a class="btn btn-solid" href={u("/programs#speaking")}>Speaking Topics</a>
          <a class="btn" href={wa("speaking")} target="_blank" rel="noopener">Invite Coach Daru</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CREDENTIALS -->
  <section class="creds section">
    <div class="wrap">
      <div class="center wrap-narrow" data-reveal>
        <span class="eyebrow">Internationally accredited</span>
        <h2 class="h2 caps">Credentials & Accreditation</h2>
        <hr class="rule" />
      </div>

      <div class="cred-block" data-reveal>
        <h3 class="eyebrow">Master coach credential</h3>
        <ul class="tiles six" role="list">
          {masterCredentials.map((c) => (
            <li class="tile">
              <span class="logo"><Image src={badgeImg[c.logo]} alt="" widths={[Math.min(badgeImg[c.logo].width, 400)]} sizes="180px" class:list={["badge-img", { wide: isWide(c.logo) }]} /></span>
              <strong>{c.name}</strong>
              <span class="by">{c.by}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="cred-split">
        <div class="cred-block" data-reveal>
          <h3 class="eyebrow">Accredited member</h3>
          <ul class="tiles three" role="list">
            {accreditedMembers.map((m) => (
              <li class="tile" title={m.full}>
                <span class="logo"><Image src={badgeImg[m.logo]} alt={`${m.name}, ${m.full}`} widths={[Math.min(badgeImg[m.logo].width, 400)]} sizes="180px" class:list={["badge-img", { wide: isWide(m.logo) }]} /></span>
              </li>
            ))}
          </ul>
        </div>
        <div class="cred-block" data-reveal style="--d:.1s">
          <h3 class="eyebrow">Chief instructor & program designer</h3>
          <ul class="tiles three" role="list">
            {instructorBadges.map((b) => (
              <li class="tile">
                <span class="logo"><Image src={badgeImg[b]} alt="" widths={[Math.min(badgeImg[b].width, 400)]} sizes="180px" class:list={["badge-img", { wide: isWide(b) }]} /></span>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <p class="center cred-more"><a class="link-line" href={u("/programs#certification")}>See the certification programs <Icon name="arrow-right" /></a></p>
    </div>
  </section>

  <!-- AWARDS -->
  <section class="awards dark grain section">
    <div class="wrap awards-grid">
      <div class="award-photo media" data-reveal>
        <Image src={award100} alt="Coach Daru receiving the 100 Best Global Coaching Leader award" width={666} />
      </div>
      <div data-reveal style="--d:.1s">
        <span class="eyebrow">Recognition</span>
        <h2 class="h2">Award-winning, on the global stage</h2>
        <hr class="rule" />
        <ul class="award-list" role="list">
          {awards.map((a) => (
            <li>
              <span class="yr">{a.year}</span>
              <span><strong>{a.title}</strong><br /><span class="muted small">{a.by}</span></span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <Ventures showClients />

  <CtaBand />
</Base>

<style>
  /* Hero */
  .hero { display: grid; min-height: min(100svh, 900px); }
  .hero-photo { position: relative; min-height: 62svh; }
  .hero-photo :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 40% 30%; }
  .hero-photo::after {
    content: ""; position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(26, 26, 26, 0.35) 0%, rgba(26, 26, 26, 0) 30%, rgba(26, 26, 26, 0.2) 70%, var(--char-900) 100%);
  }
  .hero-copy { position: relative; padding: 0 var(--gutter) clamp(3rem, 2rem + 5vw, 5rem); margin-top: -4rem; }
  .hero-copy > * + * { margin-top: 1.5rem; }
  .hero-copy .btn-row { margin-top: 2.2rem; }
  .hero .lead { max-width: 52ch; }
  .hero-why {
    max-width: 34ch; padding-left: 1.1rem; border-left: 2px solid var(--gold);
    font-family: var(--serif); font-size: clamp(1.2rem, 1.05rem + 0.6vw, 1.55rem); line-height: 1.45; color: #f2eee9;
  }
  @media (min-width: 900px) {
    .hero { grid-template-columns: 46% 1fr; align-items: center; }
    .hero-photo { height: 100%; min-height: 0; }
    .hero-photo::after { background: linear-gradient(90deg, rgba(26, 26, 26, 0) 55%, var(--char-900) 100%), linear-gradient(180deg, rgba(26, 26, 26, 0.55) 0%, rgba(26, 26, 26, 0) 25%); }
    .hero-copy { margin: 0; padding: calc(var(--header-h) + 3rem) clamp(2rem, 5vw, 6rem) 4rem clamp(2rem, 4vw, 4.5rem); max-width: 760px; }
  }

  /* Proof */
  .proof { border-bottom: 1px solid var(--line); }
  .proof-grid { display: grid; gap: 2.5rem; align-items: center; }
  .proof-grid h2 { margin-top: 0.8rem; }
  .proof-grid p { margin-top: 0.6rem; max-width: 46ch; }
  .badges { display: flex; flex-wrap: wrap; gap: clamp(1.2rem, 3vw, 3rem); justify-content: center; }
  .badges li { display: grid; justify-items: center; align-content: start; gap: 0.3rem; text-align: center; max-width: 170px; }
  .badges :global(img) { margin-bottom: 0.7rem; }
  .badges strong { font-size: var(--fs-small); font-weight: 600; line-height: 1.4; }
  .badges :global(img) { height: clamp(84px, 6vw + 36px, 112px); }
  .badges span { font-size: 0.78rem; color: var(--muted); }
  @media (min-width: 900px) { .proof-grid { grid-template-columns: 1fr 1.2fr; } .badges { justify-content: flex-end; } }

  /* About */
  .about { padding: clamp(1rem, 2vw, 1.6rem); }
  .about-grid { display: grid; max-width: 1400px; margin-inline: auto; }
  .about-card { background: var(--off); padding: clamp(2.5rem, 2rem + 4vw, 6rem) clamp(1.5rem, 1rem + 5vw, 6rem); }
  .about-card > * + * { margin-top: 1.2rem; }
  .about-card h2 { margin-top: 1rem; line-height: 1.02; }
  .tiny-caps { font-size: var(--fs-micro); letter-spacing: 0.24em; font-weight: 600; color: var(--muted); }
  .about-card .stack { max-width: 52ch; color: var(--ink-soft); }
  .about-card .signature { margin-top: 2rem; }
  .about-card .link-line { margin-top: 2rem; }
  .about-photo { min-height: 480px; background: #fff; }
  @media (min-width: 900px) { .about-grid { grid-template-columns: 1fr 1fr; } .about-photo { min-height: 100%; } }

  /* Stats */
  .stats-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2.5rem 1.5rem; }
  .num { font-family: var(--serif); font-size: clamp(2.4rem, 1.8rem + 2.4vw, 3.8rem); color: #fff; line-height: 1; }
  .lbl { margin-top: 0.8rem; font-size: var(--fs-small); color: #a29c95; max-width: 24ch; }
  @media (min-width: 900px) { .stats-grid { grid-template-columns: repeat(4, 1fr); } .stats-grid > div + div { border-left: 1px solid var(--line-dark); padding-left: 2rem; } }

  /* Services */
  .services .lead { margin-top: 0.5rem; }
  .svc-grid { display: grid; margin-top: clamp(2.5rem, 2rem + 3vw, 4.5rem); gap: 2px; }
  .svc {
    display: grid; justify-items: center; align-content: start; text-align: center;
    padding: clamp(2.5rem, 2rem + 2vw, 4rem) clamp(1.5rem, 1rem + 2vw, 2.8rem);
    transition: background 0.35s var(--ease);
  }
  .svc:hover { background: var(--char-700); }
  .svc :global(svg) { color: var(--greige); }
  .svc h3 { margin-top: 1.6rem; font-size: 1.15rem; line-height: 1.35; }
  .svc p { color: #b7b1aa; font-size: var(--fs-small); max-width: 32ch; }
  .more { display: inline-flex; align-items: center; gap: 0.5em; margin-top: 1.6rem; font-size: var(--fs-micro); font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; }
  .svc .more { color: var(--greige); }
  @media (min-width: 900px) { .svc-grid { grid-template-columns: repeat(3, 1fr); } }

  /* Speaking */
  .speak-grid { display: grid; }
  .speak-photo { min-height: 520px; }
  .speak-copy { padding-inline: var(--gutter); max-width: 640px; }
  .speak-copy > * + * { margin-top: 1.2rem; }
  .speak-copy h2 { margin-top: 1rem; }
  .topics { border-top: 1px solid var(--line); }
  .topics li { display: flex; gap: 1.2rem; align-items: baseline; padding: 1rem 0; border-bottom: 1px solid var(--line); font-family: var(--serif); font-size: 1.2rem; }
  .topics .n { font-family: var(--sans); font-size: var(--fs-micro); font-weight: 600; letter-spacing: 0.15em; color: var(--muted); }
  .speak-copy .btn-row { margin-top: 2.2rem; }
  @media (min-width: 900px) {
    .speak-grid { grid-template-columns: 45% 1fr; }
    .speak-photo { min-height: 100%; }
    .speak-copy { padding-inline: clamp(2.5rem, 5vw, 6rem); }
  }

  /* Credentials: every logo sits in an identical tile, so sizes and spacing stay consistent. */
  .cred-block { margin-top: clamp(2.5rem, 2rem + 2vw, 4rem); }
  .cred-block > h3 { padding-bottom: 1rem; margin-bottom: 1.5rem; }
  .tiles { display: grid; gap: 1px; background: var(--line); border: 1px solid var(--line); grid-template-columns: repeat(2, 1fr); }
  .tile { background: #fff; display: grid; grid-template-rows: auto auto 1fr; justify-items: center; text-align: center; padding: 1.6rem 1rem; }
  .logo { height: 80px; width: 100%; display: flex; align-items: center; justify-content: center; }
  .logo :global(img) { width: auto; height: 72px; max-width: 100%; object-fit: contain; }
  .logo :global(img.wide) { height: auto; width: 116px; max-height: 54px; }
  .tile strong { margin-top: 1.2rem; font-size: var(--fs-small); font-weight: 600; line-height: 1.4; min-height: 2.8em; display: flex; align-items: flex-start; justify-content: center; max-width: 20ch; }
  .tile .by { margin-top: 0.3rem; font-size: 0.75rem; color: var(--muted); line-height: 1.5; max-width: 22ch; }
  .three .tile { padding-block: 1.3rem; }
  .cred-split { display: grid; gap: 0 2.5rem; }
  .cred-more { margin-top: 3rem; }
  @media (min-width: 700px) { .tiles { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1000px) { .six { grid-template-columns: repeat(6, 1fr); } .cred-split { grid-template-columns: 1fr 1fr; } }

  /* Awards */
  .awards-grid { display: grid; gap: clamp(2.5rem, 4vw, 5rem); align-items: center; }
  .award-photo { max-width: 540px; }
  .award-list li { display: grid; grid-template-columns: 9.5rem 1fr; gap: 1rem; padding: 1.1rem 0; border-bottom: 1px solid var(--line-dark); }
  .award-list li:first-child { border-top: 1px solid var(--line-dark); }
  .yr { font-size: var(--fs-micro); font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--greige); padding-top: 0.25rem; }
  .award-list strong { font-family: var(--serif); font-weight: 400; font-size: 1.15rem; color: #fff; }
  @media (min-width: 900px) { .awards-grid { grid-template-columns: 1fr 1fr; } }

</style>
