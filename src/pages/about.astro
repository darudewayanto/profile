---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url";
import PageHero from "../components/PageHero.astro";
import Image from "../components/Img.astro";
import CtaBand from "../components/CtaBand.astro";
import Gallery from "../components/Gallery.astro";
import { badgeImg, brandImg, crispWidth } from "../lib/assets";
import { site, journey, stats, masterCredentials, accreditedMembers, awards, ventures } from "../data/site";
import portrait from "../assets/photos/daru-portrait.png";
import lounge from "../assets/photos/daru-lounge.jpg";
import entStage from "../assets/photos/daru-entrepreneur-stage.jpg";
import city from "../assets/photos/city.png";
---
<Base title="About" description="The story of Daru Dewayanto: corporate leader, entrepreneur and the first holder of three master agile coach credentials in Asia & Australia.">
  <PageHero eyebrow="About Coach Daru" title="30+ years as corporate leader, entrepreneur and coach" lead="The first and only holder of three board master agile coach credentials in Asia & Australia." image={city} alt="" position="center" />

  <section class="intro section">
    <div class="wrap grid">
      <div class="photo" data-reveal>
        <Image src={portrait} alt="Black and white portrait of Daru Dewayanto" widths={[500, 800, 1100]} sizes="(min-width: 900px) 460px, 90vw" />
      </div>
      <div class="copy" data-reveal style="--d:.1s">
        <span class="eyebrow">{site.postnominals}</span>
        <h2 class="h2 caps">Daru Dewayanto</h2>
        <p class="role">{site.role}<br /><span class="muted">Indonesia · Hong Kong · Qatar · Australia</span></p>
        <hr class="rule" />
        <div class="stack lead">
          <p>I have more than 30 years of experience as a corporate leader and entrepreneur, and I have worked as a coach since 2011.</p>
          <p>Since 2011 I've coached more than 1,000 companies, executives and business owners, and delivered over 5,000 hours of training, coaching and mentoring. In 2017 I turned that practice into HADE, an internationally accredited agile coaching firm that today spans 28 firms and 180 associate coaches.</p>
          <p>I hold the ICF Master Certified Coach (MCC), the ICAgile Certified Expert in Agile Coaching (ICE-AC) and the MIND Master Practitioner credential, the first person in Asia & Australia to hold all three. I also design and lead three internationally accredited coaching certification programs.</p>
        </div>
        <p class="signature">Daru Dewayanto</p>
      </div>
    </div>
  </section>

  <section class="stats darker section-tight">
    <dl class="wrap stats-grid">
      {stats.map((s) => (<div><dt class="sr-only">{s.label}</dt><dd class="num">{s.value}</dd><dd class="lbl">{s.label}</dd></div>))}
    </dl>
  </section>

  <section class="journey section off">
    <div class="wrap">
      <div class="center wrap-narrow" data-reveal>
        <h2 class="h2 caps">Career Timeline</h2>
        <hr class="rule" />
      </div>
      <ol class="timeline" role="list">
        {journey.map((j, i) => (
          <li data-reveal style={`--d:${i * 0.08}s`}>
            <span class="period">{j.period}</span>
            <h3 class="h3">{j.title}</h3>
            <p class="muted">{j.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section-tight off">
    <Gallery items={[
      { src: lounge, alt: "Coach Daru in a lounge, reviewing notes" },
      { src: entStage, alt: "Coach Daru presenting at an entrepreneur summit" },
    ]} />
  </section>

  <section class="creds section">
    <div class="wrap two">
      <div data-reveal>
        <span class="eyebrow">Master coach credential</span>
        <ul class="list" role="list">
          {masterCredentials.map((c) => (
            <li>
              <span class="logo-box"><Image src={badgeImg[c.logo]} alt="" widths={[Math.min(badgeImg[c.logo].width, 240)]} sizes="80px" class="badge-img" /></span>
              <span><strong>{c.name}</strong><br /><span class="muted small">{c.by}</span></span>
            </li>
          ))}
        </ul>
      </div>
      <div data-reveal style="--d:.1s">
        <span class="eyebrow">Accredited member</span>
        <ul class="list" role="list">
          {accreditedMembers.map((m) => (
            <li>
              <span class="logo-box"><Image src={badgeImg[m.logo]} alt="" widths={[Math.min(badgeImg[m.logo].width, 240)]} sizes="80px" class="badge-img" /></span>
              <span><strong>{m.name}</strong><br /><span class="muted small">{m.full}</span></span>
            </li>
          ))}
        </ul>
        <span class="eyebrow" style="margin-top:3rem">Awards</span>
        <ul class="list" role="list">
          {awards.map((a) => (<li><span class="yr">{a.year}</span><span><strong>{a.title}</strong><br /><span class="muted small">{a.by}</span></span></li>))}
        </ul>
      </div>
    </div>
    <ul class="wrap brands" role="list" data-reveal>
      {ventures.map((v) => {
        const img = brandImg[v.logo];
        const wide = img.width / img.height > 1.5;
        const href = v.href || u("/programs#ventures");
        // Optical sizing: thin wordmarks need more width, heavy ones less, so all six read equally large.
        const w = { "agile-hijrah-coaching": 190, "hade-navy": 112, "hade-ai": 118 }[v.logo] ?? 136;
        return (
          <li>
            <a href={href} target={v.href ? "_blank" : undefined} rel={v.href ? "noopener" : undefined} title={v.name}>
              <Image src={img} alt={v.name} widths={[Math.min(img.width, 400)]} sizes="180px" class:list={["badge-img", { wide }]} style={wide ? `width:${w}px` : undefined} />
            </a>
          </li>
        );
      })}
    </ul>
  </section>

  <CtaBand />
</Base>

<style>
  .grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(2.5rem, 5vw, 6rem); align-items: start; }
  .photo { background: #fff; max-width: 460px; }
  img.photo, .photo :global(img) { width: 100%; height: auto; }
  .copy > * + * { margin-top: 1.2rem; }
  .role { font-size: var(--fs-small); font-weight: 500; line-height: 1.7; }
  .copy .signature { margin-top: 2rem; }
  @media (min-width: 900px) { .grid { grid-template-columns: 460px 1fr; } .photo { position: sticky; top: 100px; } }

  .stats-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2.5rem 1.5rem; }
  .num { font-family: var(--serif); font-size: clamp(2.4rem, 1.8rem + 2.4vw, 3.6rem); color: #fff; line-height: 1; }
  .lbl { margin-top: 0.8rem; font-size: var(--fs-small); color: #a29c95; max-width: 24ch; }
  @media (min-width: 900px) { .stats-grid { grid-template-columns: repeat(4, 1fr); } }

  .timeline { display: grid; gap: 0; margin-top: 3rem; }
  .timeline li { padding: 2rem 0; border-top: 1px solid var(--line-strong); display: grid; gap: 0.6rem; }
  .period { font-size: var(--fs-micro); font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--greige-deep); }
  @media (min-width: 900px) {
    .timeline { grid-template-columns: repeat(4, 1fr); gap: 2rem; }
  }

  .two { display: grid; gap: 3rem 5rem; }
  .list { margin-top: 1.2rem; }
  .list li { display: grid; grid-template-columns: 80px 1fr; gap: 1.2rem; align-items: center; padding: 1rem 0; border-bottom: 1px solid var(--line); line-height: 1.5; }
  .logo-box { display: grid; place-items: center; width: 80px; height: 56px; }
  .logo-box :global(img) { max-width: 80px; max-height: 56px; width: auto; height: auto; object-fit: contain; }
  .ph { width: 56px; height: 56px; border-radius: 50%; border: 1px solid var(--line-strong); display: grid; place-items: center; justify-self: center; font-family: var(--serif); }
  .yr { font-size: 0.62rem; font-weight: 600; letter-spacing: 0.1em; color: var(--greige-deep); text-transform: uppercase; }
  .list strong { font-weight: 600; font-size: var(--fs-small); }
  /* All ventures in one row: equal slots, equal logo height, wide wordmarks capped by width. */
  .brands { list-style: none; padding: 3rem 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.5rem 1.5rem; align-items: center; margin-top: 5rem; border-top: 1px solid var(--line); }
  .brands li { display: flex; justify-content: center; }
  .brands a { display: flex; align-items: center; justify-content: center; height: 68px; opacity: 0.85; transition: opacity 0.25s, transform 0.25s var(--ease); }
  .brands a:hover { opacity: 1; transform: translateY(-2px); }
  .brands :global(img) { height: 62px; width: auto; max-width: 100%; object-fit: contain; }
  .brands :global(img.wide) { height: auto; max-width: 100%; max-height: 56px; }
  @media (min-width: 900px) { .brands { grid-template-columns: repeat(6, 1fr); } }
  @media (min-width: 900px) { .two { grid-template-columns: 1fr 1fr; } }
</style>
